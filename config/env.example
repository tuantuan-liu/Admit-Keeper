# ===== admit-keeper 插件侧 .env 参考 =====
# 复制到你实际使用的 .env：单配置为 ~/.hermes/.env；命名 profile 为其 profile 的 .env。
# 插件本体运行在 gateway 进程里，读这份 .env。

# 受管平台（走准入；列表之外的平台直接放行）。加平台 = 改这一个配置，无需改代码。
ADMIT_GATE_PLATFORMS=feishu

# 共享名册 DB 路径（可选，默认 $HERMES_HOME/admit_keeper.db，即网关进程的 HERMES_HOME）。
# 若要显式指定，务必写【绝对路径】，且与 MCP 侧 config.yaml 的 mcp_servers 一致。
# 注意：不要用 ~ 或 $VAR（Python os.path.exists 不展开，会误判库不存在→fail-open 全放行）。
# 单配置（Windows）:
#   ADMIT_KEEPER_DB=C:/Users/你的用户名/.hermes/admit_keeper.db
# 命名 profile（Linux）:
#   ADMIT_KEEPER_DB=/home/<user>/.hermes/profiles/<profile>/admit_keeper.db

# 永久白名单（可选，多个用逗号分隔）。只在“无记录”或“已过期”时生效，不覆盖 banned。
ADMIT_ALLOWED_USERS=ou_xxx,ou_yyy

# 数据不可得（DB 缺失/异常）时的默认方向：
#   1 / true / 空  = 放行（与无插件时一致，推荐默认）
#   0 / false      = 拒绝（更安全，但会因瞬时 DB 锁而误拦）
ADMIT_FAIL_OPEN=1

# 若沿用飞书，用「插件当唯一门卫」方案：
FEISHU_ALLOW_ALL_USERS=true
